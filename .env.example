# ---------------------------------------------------------------------------
# Copy to `.env.local` for local dev, and set the same values in Vercel.
# ---------------------------------------------------------------------------

# Where validated leads are forwarded (PRD §8). Provider-agnostic: point it at a
# CRM endpoint, a Zapier/Make catch hook, or an email service webhook.
# Required — without it /api/lead returns 503 and logs the lead server-side.
LEAD_WEBHOOK_URL=

# Meta Pixel ID (PRD §11). Optional — the pixel is not mounted when unset.
NEXT_PUBLIC_META_PIXEL_ID=

# Production origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
