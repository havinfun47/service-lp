# ---------------------------------------------------------------------------
# Copy to `.env.local` for local dev. For the deployed site, set these as
# repository variables/secrets so the GitHub Actions build picks them up
# (Settings → Secrets and variables → Actions).
# ---------------------------------------------------------------------------

# Where the lead form posts. This is a STATIC build with no server, so the
# browser posts here directly — a Formspree form URL, a Zapier/Make catch hook,
# or a CRM inbound endpoint.
#
# ⚠️ This value ships in the client bundle and is publicly visible. Use an
# endpoint that only accepts submissions and carries no account secret.
# Never put an API key here.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Meta Pixel ID. Optional — the pixel is not mounted when unset.
NEXT_PUBLIC_META_PIXEL_ID=

# Public site URL, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://havinfun47.github.io/service-lp
